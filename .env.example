# ============================================
# 1. PROJECT METADATA
# ============================================
PROJECT_NAME="Purchasing Go"
PROJECT_VERSION=1.0.0
DEBUG=True
# ENV: development / production (digunakan script internal)
ENV=development

# ============================================
# 2. DATABASE CONFIGURATION
# ============================================
# MySQL eksternal (container mysql-container di jaringan app-bridge).
# Gunakan DB_HOST=localhost jika backend dijalankan di host (bukan Docker).
DB_HOST=mysql-container
DB_PORT=3306
DB_NAME=db_purchasing
DB_USER=root
DB_PASSWORD=rootpassword

# Opsional: isi manual jika ingin override. Kosongkan agar URL dibangun dari DB_* di atas.
# DATABASE_URL=mysql+pymysql://root:rootpassword@mysql-container:3306/db_purchasing?charset=utf8mb4
DATABASE_URL=

# Redis (cache + rate limiting)
# Dev default (tanpa auth). Untuk production gunakan `.env.production.example`.
REDIS_URL=redis://purchasing_go_redis_dev:6379/0
REDIS_ENABLED=True
REDIS_FAIL_OPEN=True
CACHE_DEFAULT_TTL_SECONDS=300
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ============================================
# 3. SECURITY & AUTHENTICATION
# ============================================
# PENTING: Ganti SECRET_KEY ini saat naik ke server produksi!
SECRET_KEY=12341234123412341234123412341234
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Idle logout & modal peringatan (SPA memuat via GET /auth/session-config)
# SESSION_IDLE_TIMEOUT_MINUTES=0 → sama dengan ACCESS_TOKEN_EXPIRE_MINUTES
SESSION_IDLE_TIMEOUT_MINUTES=0
SESSION_WARNING_SECONDS=60
SESSION_REFRESH_BUFFER_SECONDS=60
# Flag Secure pada cookie auth (True jika HTTPS; False untuk http://localhost)
COOKIE_SECURE=False
# Registrasi akun lewat API (false = hanya admin yang bisa buat user)
ALLOW_PUBLIC_REGISTER=False

# Cloudflare Turnstile (bot protection pada login). Kosongkan di lokal jika tidak dipakai.
# Dokumentasi: https://developers.cloudflare.com/turnstile/get-started/server-side-validation/
# Kunci uji Cloudflare (selalu lolos): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ============================================
# 4. FRONTEND & GATEWAY CONFIGURATION
# ============================================
# VITE_ prefix wajib agar React bisa membaca variabel ini
VITE_API_URL=/api/v1

# CORS: Izinkan akses dari domain ini
# Gunakan format JSON Array jika backend membutuhkan parsing
BACKEND_CORS_ORIGINS=["http://localhost", "http://127.0.0.1"]

# ============================================
# 5. SERVER & LOGGING
# ============================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================
# 6. FILE UPLOAD & STORAGE
# ============================================
# MAX_UPLOAD_SIZE dalam KB (3072 = 3MB)
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads

# ============================================
# 7. INITIAL ADMIN SEEDING
# ============================================
# Akun admin default yang akan dibuat saat inisialisasi database
INIT_ADMIN_USERNAME=superadmin
INIT_ADMIN_EMAIL=superadmin@local.com
INIT_ADMIN_PASSWORD=12341234
INIT_ADMIN_FIRSTNAME=Super
INIT_ADMIN_LASTNAME=Admin

# ============================================
# 8. EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP_TLS=True
# SMTP_PORT=587
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=admin@laundrypondok.com
# EMAILS_FROM_NAME="Laundry Pondok System"

COMPOSE_PROJECT_NAME=purchasing-go
# MinIO root credentials (S3 access key / secret for admin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# S3 "region" label for this MinIO site (use the same value in BE AWS SDK / S3 client).
# Common: us-east-1. You can use e.g. ap-southeast-1 for naming only — it is not tied to AWS.
MINIO_SITE_REGION=us-east-1
# Buckets created once by minio-init (idempotent)
MINIO_DEFAULT_BUCKET=purchasing-go-documents
# Aset publik (atur policy/CORS di Console atau mc sesuai kebutuhan)
MINIO_PUBLIC_BUCKET=purchasing-go-public-documents
# Host ports (API S3-compatible, Web console)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend object storage (S3 / MinIO) ---
# When true: media uploads go to MinIO (private bucket + S3_PUBLIC_BUCKET).
# When false or credentials empty: files go under backend UPLOAD_DIR.
# Untuk stack Docker + layanan minio di compose ini, gunakan true.
S3_ENABLED=true
# Inside Docker Compose, default matches the minio service. For local Python without Docker, use http://127.0.0.1:9000
S3_ENDPOINT_URL=http://minio:9000
# Optional overrides (defaults fall back to MINIO_* above via docker-compose environment)
# S3_BUCKET=purchasing-go-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# S3_PUBLIC_BROWSER_BASE_URL=http://localhost:9000