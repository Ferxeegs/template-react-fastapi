# ============================================
# PRODUCTION ENV TEMPLATE
# ============================================
# Copy this file to `.env` on the server, then replace all placeholder values.
# Never commit real production secrets to git.
# Struktur mengikuti `.env.example`; nilai dioptimalkan untuk stack `docker compose --profile prod`.

# ============================================
# 1. PROJECT METADATA
# ============================================
PROJECT_NAME="Purchasing Go"
PROJECT_VERSION=1.0.0
DEBUG=False
# ENV: development / production (digunakan script internal)
ENV=production

# ============================================
# 2. DATABASE CONFIGURATION
# ============================================
# MySQL eksternal (container mysql-container di jaringan app-bridge).
DB_HOST=mysql-container
DB_PORT=3306
DB_NAME=db_purchasing
DB_USER=root
DB_PASSWORD=replace_with_strong_db_password

# Kosongkan agar URL dibangun otomatis dari DB_* di atas.
DATABASE_URL=

# Redis (cache + rate limiting) — production memakai password (lihat docker-compose `boilerplate_redis_prod`)
# Gunakan password kuat acak (minimal 32 karakter).
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@purchasing_go_redis_prod:6379/0
REDIS_ENABLED=True
REDIS_FAIL_OPEN=False
CACHE_DEFAULT_TTL_SECONDS=300
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ============================================
# 3. SECURITY & AUTHENTICATION
# ============================================
# Generate a long random key (at least 32 chars).
SECRET_KEY=dJQm7iofGM7awUq4UCruj8Yy5Yu3Q1viFagkKG0eBWR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=0
SESSION_WARNING_SECONDS=60
SESSION_REFRESH_BUFFER_SECONDS=60
# Wajib True di produksi (HTTPS) agar cookie auth tidak dikirim lewat HTTP biasa
COOKIE_SECURE=True
ALLOW_PUBLIC_REGISTER=False

# Cloudflare Turnstile (bot protection pada login). Setel kunci produksi dari dashboard Cloudflare.
# Dokumentasi: https://developers.cloudflare.com/turnstile/get-started/server-side-validation/
# Tanpa TURNSTILE_SECRET_KEY, backend tidak memaksa verifikasi. Tanpa VITE_TURNSTILE_SITE_KEY, widget tidak tampil.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ============================================
# 4. FRONTEND & GATEWAY CONFIGURATION
# ============================================
# VITE_ prefix wajib agar React bisa membaca variabel ini
# Jika frontend dan backend di domain + reverse proxy yang sama:
VITE_API_URL=/api/v1

# CORS: Izinkan akses dari domain produksi (format JSON array)
# Contoh:
# BACKEND_CORS_ORIGINS=["https://app.yourdomain.com","https://yourdomain.com"]
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com"]

# ============================================
# 5. SERVER & LOGGING
# ============================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================
# 6. FILE UPLOAD & STORAGE
# ============================================
# Max upload size in bytes (5242880 ≈ 5 MB)
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads

# ============================================
# 7. INITIAL ADMIN SEEDING
# ============================================
# Akun admin default yang akan dibuat saat inisialisasi database
# Used when init/seeding runs. Set strong password and rotate after first login.
INIT_ADMIN_USERNAME=superadmin
INIT_ADMIN_EMAIL=superadmin@local.com
INIT_ADMIN_PASSWORD=12341234
INIT_ADMIN_FIRSTNAME=Super
INIT_ADMIN_LASTNAME=Admin

# ============================================
# 8. EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP_TLS=True
# SMTP_PORT=587
# SMTP_HOST=smtp.yourdomain.com
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASSWORD=replace_with_smtp_password
# EMAILS_FROM_EMAIL=no-reply@yourdomain.com
# EMAILS_FROM_NAME="Purchasing Go"

COMPOSE_PROJECT_NAME=purchasing-go
# MinIO root credentials (S3 access key / secret for admin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# S3 "region" label for this MinIO site (use the same value in BE AWS SDK / S3 client).
# Common: us-east-1. You can use e.g. ap-southeast-1 for naming only — it is not tied to AWS.
MINIO_SITE_REGION=us-east-1
# Buckets created once by minio-init (idempotent)
MINIO_DEFAULT_BUCKET=purchasing-go-documents
# Aset publik (atur policy/CORS di Console atau mc sesuai kebutuhan)
MINIO_PUBLIC_BUCKET=purchasing-go-public-documents
# Host ports (API S3-compatible, Web console) — sesuaikan jika memetakan port di server
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend object storage (S3 / MinIO) ---
# When true: media uploads go to MinIO (private bucket + S3_PUBLIC_BUCKET).
# When false or credentials empty: files go under backend UPLOAD_DIR.
# Untuk stack Docker + layanan minio di compose ini, gunakan true.
S3_ENABLED=true
# Inside Docker Compose, default matches the minio service.
S3_ENDPOINT_URL=http://minio:9000
# Optional overrides (defaults fall back to MINIO_* above via docker-compose environment)
# S3_BUCKET=purchasing-go-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_USE_SSL=false
# URL MinIO/S3 yang bisa dijangkau browser (path-style, tanpa trailing slash).
# Disarankan lewat reverse proxy domain utama agar tidak expose port 9000 publik.
# Contoh: https://app.yourdomain.com/minio
S3_PUBLIC_BROWSER_BASE_URL=https://app.yourdomain.com/minio
